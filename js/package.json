{
  "name": "langley",
  "version": "0.1.2",
  "description": "For your agents",
  "repository": "git@github.com:1kbgz/langley.git",
  "author": "the langley authors <dev@1kbgz.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "unpkg": "dist/cdn/index.js",
  "jsdelivr": "dist/cdn/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "types": "./dist/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:debug": "node build.mjs --debug",
    "build:prod": "node build.mjs",
    "build:types": "tsc",
    "build": "npm-run-all build:prod build:types",
    "clean": "rm -rf dist playwright-report ../langley/extension",
    "dev": "npm-run-all -p start watch",
    "lint": "oxlint . && oxfmt --check \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "fix": "oxlint --fix . && oxfmt --write \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "preinstall": "npx only-allow pnpm",
    "prepack": "npm run build",
    "start": "http-server -p 3000 -o examples/",
    "start:tests": "http-server -p 3000 ",
    "test": "TZ=UTC vitest run",
    "watch": "nodemon --watch src -e ts,tsx,css,html --exec \"pnpm build:debug\""
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "regular-layout": "^0.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.1.0",
    "cpy": "^13.2.2",
    "esbuild": "^0.28.1",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.29.3",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
